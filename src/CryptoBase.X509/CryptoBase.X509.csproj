<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Package.props" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>X.509 certificates for CryptoBase.</Description>
    <PackageTags>$(PackageTags);x509;certificate;pki</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CryptoBase.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DerSpanReader.cs" Link="Shared\DerSpanReader.cs" />
    <Compile Include="..\Shared\RsassaPssParameters.cs" Link="Shared\RsassaPssParameters.cs" />
    <Compile Include="..\Shared\PemReader.cs" Link="Shared\PemReader.cs" />
    <Compile Include="..\Shared\Pkcs1DigestInfo.cs" Link="Shared\Pkcs1DigestInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptoBase.Abstractions\CryptoBase.Abstractions.csproj" />
  </ItemGroup>

</Project>
