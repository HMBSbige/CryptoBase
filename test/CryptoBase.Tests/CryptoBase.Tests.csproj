<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Background GC can overcount unused allocation-context space, which fails the tests that assert no allocation now and then. Remove once https://github.com/dotnet/runtime/pull/134855 ships. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- See the reference to the speed test. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.EndsWith('-x86')) Or $(RuntimeIdentifier.EndsWith('-arm'))">
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="8" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog test reads the speed test's catalog. Building the speed test without the publish properties of the tests keeps a publish of the tests from rebuilding it in place as a self-contained or native executable;
         the tests only load its assembly, so a self-contained publish of them can reference it as it is. -->
    <ProjectReference Include="..\..\benchmark\CryptoBase.SpeedTest\CryptoBase.SpeedTest.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;UseCurrentRuntimeIdentifier;SelfContained;PublishAot;_IsPublishing" />
    <ProjectReference Include="..\..\src\CryptoBase\CryptoBase.csproj" />
    <ProjectReference Include="..\..\src\CryptoBase.IO\CryptoBase.IO.csproj" />
    <ProjectReference Include="..\..\src\CryptoBase.X509\CryptoBase.X509.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="WycheproofTestVectors" Value="$(MSBuildThisFileDirectory)../wycheproof/testvectors_v1" />
    <AssemblyMetadata Include="X509LimboTestcases" Value="$(MSBuildThisFileDirectory)../x509-limbo/limbo.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Cavp/**/*.rsp" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Hpke/Vectors/*.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Signatures/Rsa/Vectors/*.txt" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="X509/Rfc9881/*.pem" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="X509/SM2/*.pem" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
